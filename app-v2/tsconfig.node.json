{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM"],
    "strict": true,
    "composite": true,
    "skipLibCheck": true,
    "noEmit": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowImportingTsExtensions": true
  },
  "include": ["vite.config.ts", "server/project-library.ts", "src/domain/project-schema.ts", "src/domain/concept.ts", "src/domain/concept-inputs.ts", "src/domain/types.ts"]
}
